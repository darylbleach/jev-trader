{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jev-gold-demo",
  "main": "src/gold/cf/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "build": {
    "command": "bun run scripts/prepare-gold-cf.ts"
  },
  "assets": {
    "directory": "./src/gold/cf/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GOLD_MODEL": "jev",
    "MODEL": "mock",
    "GOLD_DEMO": "true",
    "GOLD_DRY_RUN": "true",
    "GOLD_DUMMY_MT5": "true",
    "GOLD_INTERVAL_MS": "1000",
    "GOLD_HORIZON_MS": "6000",
    "GOLD_LOT": "0.01",
    "GOLD_SL_POINTS": "300",
    "GOLD_TP_POINTS": "200",
    "GOLD_FILL_MODE": "book",
    "GOLD_PAUSE_REALIZED_USD": "-20",
    "GOLD_PAUSE_FLOOR_USD": "-40",
    "GOLD_REVERSE": "true",
    "GOLD_MAX_SPREAD_PIPS": "80",
    "XAUUSD_SPOT_URL": "https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument/XAU/USD",
    "XAUUSD_SPOT_REFRESH_MS": "1000",
    "GOLD_MIN_REVERSE_POINTS": "1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GOLD_ROOM",
        "class_name": "GoldRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GoldRoom"]
    }
  ]
}
